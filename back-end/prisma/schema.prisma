generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  email String
  name  String
}

// npx prisma db push = Envia as alterações para o banco de dados
// npx prisma db pull= Puxa a estrutura atual do banco de dados

model produto {
  id Int @id @default(autoincrement())
  name String?
}
